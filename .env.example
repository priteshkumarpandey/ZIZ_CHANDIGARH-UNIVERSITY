# GlucoTwin Environment Configuration
PROJECT_NAME=GlucoTwin
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
DEMO_MODE=true

# Service Port Documentation:
# API: 8000
# Frontend: 3000
# TimescaleDB: 5432
# Kafka: 9092
# MLflow: 5000
# Prometheus: 9090
# Grafana: 3001

# Database (TimescaleDB / PostgreSQL)
POSTGRES_USER=glucouser
POSTGRES_PASSWORD=glucopass
POSTGRES_DB=glucotwin
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://glucouser:glucopass@timescaledb:5432/glucotwin

# Streaming Replay and Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CGM_TOPIC=cgm
KAFKA_ACTIVITY_TOPIC=activity
KAFKA_MEALS_TOPIC=meals
KAFKA_ALERT_TOPIC=glucotwin.alerts
KAFKA_CONSUMER_GROUP=glucotwin-serving-group
REPLAY_SPEED=30.0
REPLAY_PATIENT_ID=DEMO_PAT_001

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=glucotwin-forecasting

# API and CORS
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
RANDOM_SEED=42

# Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/stream

# Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
